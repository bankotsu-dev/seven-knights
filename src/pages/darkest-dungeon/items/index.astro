---
import { getCollection } from "astro:content";
import Title from "../../../components/Title.astro";
import Layout from "../../../layouts/Layout.astro";
import ItemsCard from "@/components/darkest-dungeon/ItemsCard.astro";

const dd_items = await getCollection("dd_items");
---

<Layout>
    <section>
        <Title title="ITEMS" />
        <div class="flex flex-nowrap mx-2 justify-center">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2">
                {dd_items.map(item => (
                    <ItemsCard key={item.id} item={item} />
                ))}
            </div>
        </div>
    </section>
</Layout>