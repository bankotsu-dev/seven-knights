---
import Title from "@components/Title.astro";
import Layout from "@layouts/Layout.astro";
import FactionGrid from "@components/seven-knights/FactionGrid.astro";
import { factions } from "@/data/skr_factions";
---

<Layout>
  <section>
    <Title title="HERO CODEX" />
    {
      factions.map((faction) => (
        <FactionGrid 
          tittle = { faction.tittle }
          faction = { faction.faction }
          icon = { faction.icon }
          unknown = { faction.unknown }
        />
      ))
    }
  </section>
</Layout>
