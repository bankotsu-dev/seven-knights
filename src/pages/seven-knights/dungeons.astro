---
import Title from "@components/Title.astro";
import Layout from "@layouts/Layout.astro";
import DungeonTab from "@components/seven-knights/DungeonTab.astro";
import DungeonContent from "@components/seven-knights/DungeonContent.astro";
import { dungeons } from "@/data/skr_dungeons";
---

<Layout>
  <section>
    <Title title="POWER UP DUNGEONS" />
  
    <div class="flex flex-col">

        <!-- Tabs arriba -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 p-3"
            id="dungeon-tab"
            data-tabs-toggle="#dungeon-tab-content"
            role="tablist"
        >
            {
            dungeons.map((dungeon) => (
                <DungeonTab dungeon={dungeon.id} />
            ))
            }
        </div>

        <!-- Contenido abajo -->
        <div class="w-full px-4" id="dungeon-tab-content">
            {
            dungeons.map((dungeon) => (
                <DungeonContent dungeon={dungeon} />
            ))
            }
        </div>

    </div>

  </section>
</Layout>
