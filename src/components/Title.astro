---
const { title } = Astro.props;
---

<h1
  class="relative mb-4 md:mb-8 p-4 md:p-6 text-3xl md:text-5xl text-cyan-300 font-bold
         tracking-wide drop-shadow-md border-b border-slate-700/50 text-center select-none
         bg-gradient-to-b from-gray-800 via-gray-950 to-gray-800 rounded-lg">
  {title}
</h1>
