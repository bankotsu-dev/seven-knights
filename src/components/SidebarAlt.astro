                     </a>
                  </li>
                  <li>
                     <a href="/darkest-dungeon/items" class="flex items-center w-full p-2 transition duration-75 rounded-lg pl-11 group text-white hover:bg-gray-700">
                        Items
                     </a>
                  </li>
                  <li>
                     <a href="/darkest-dungeon/heroes" class="flex items-center w-full p-2 transition duration-75 rounded-lg pl-11 group text-white hover:bg-gray-700">
