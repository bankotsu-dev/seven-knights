                  </li>
                  <li>
                     <a href="/seven-knights/cr" class="flex items-center w-full p-2 transition duration-75 rounded-lg pl-11 group text-white hover:bg-gray-700">
                        Castle Rush
                     </a>
                  </li>
            </ul>
         </li>
