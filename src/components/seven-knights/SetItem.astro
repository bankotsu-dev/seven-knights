---
import { getEntry } from "astro:content";
import type { Set, Equipment } from "@/types/skr";

interface Props {
  equip: Equipment;
}

const { equip } = Astro.props;
const uid = crypto.randomUUID();
const setData = await getEntry("skr_sets", equip.type);
const set: Set = setData!.data;
---

<div
  data-popover-target={`popover${uid}`}
  class="bg-zinc-800/80 border border-zinc-700 p-2 text-xs text-center rounded-lg shadow-sm hover:bg-zinc-700 transition"
>
  <div class="max-w-24 mx-auto">
    <img
      src={equip?.image}
      alt={equip?.type || "equip"}
      class="w-full aspect-square object-cover mb-1 rounded"
      draggable="false"
    />
  </div>
  <p class="">{equip?.substat1}</p>
  <p class="text-zinc-400">{equip?.substat2}</p>
</div>

<div
  data-popover
  id={`popover${uid}`}
  role="tooltip"
  class="absolute z-50 invisible flex h-42 gap-2 text-sm transition-opacity duration-300
         bg-gray-900 border border-gray-500 rounded-md shadow-xs opacity-0"
>
  <div class="h-full aspect-1/1 flex-nowrap p-2">
    <img
      src={equip.image}
      alt={equip.type}
      class="w-full h-full object-cover overflow-hidden p-1"
      draggable="false"
    />
  </div>
  <div class="pr-4 flex flex-col pt-2">
    <h4 class="font-bold text-2xl text-cyan-300">{set.id}</h4>
    <p class="text-base mt-2 max-w-xs break-words">
      {set.effect1}
    </p>
    <p class="text-base max-w-xs break-words">
      {set.effect2}
    </p>
    <p class="text-base max-w-xs break-words">
      {set.effect3}
    </p>
  </div>

  <div data-popper-arrow class="bg-gray-500"></div>
</div>
