---
import type { Skill, Effect } from "@/types/skr";

interface Props {
    skill: Skill;
    type: string;
}

const {skill, type} = Astro.props;
---
<div class="bg-zinc-800/80 p-2 md:p-4 my-2 rounded-md border border-gray-600">
    <div class="flex">
        <img src={skill.image} alt={skill.image} class="w-16 h-16 rounded-md" draggable="false">
        <div class="ml-2 leading-5">
            <h5 class="font-bold text-lg leading-5">{skill.name}</h5>
            <p class="text-sm text-gray-400">{type}</p>
            {skill.cd ? <p>CD: {skill.cd}</p> : ""}
        </div>
    </div>
    <div class="flex-col mt-1">
        {
            skill.effects.map((effect: Effect) => (
                <div class="leading-5">
                    <p class="font-semibold pt-2">{effect.desc}</p>
                    {
                        effect.effects.map((effect) => (
                            <p>- {effect}</p>
                        ))
                    }
                </div>
            ))
        }
        <!-- Enhancement -->
        <div class="rounded-md border border-emerald-700/60 bg-emerald-950/50 p-2 mt-2 leading-5">
            <p class="font-semibold text-emerald-300 flex items-center">
                <span class="pr-1">
                    <img src="/7knights/assets/Skill_Enhancement.webp" alt="Skill_Enhancement.webp" class="w-6 h-6" draggable="false">
                </span>
                Skill Enhancement Effects
            </p>
            {
                skill.enhancement.map((e) => (
                    <p>- {e}</p>
                ))
            }
        </div>
        <!-- Transcendence 2 -->
        {
            skill.transcendence2 && (
                <div class="rounded-md border border-fuchsia-700/50 bg-fuchsia-950/40 p-2 mt-2 leading-5">
                    <p class="font-semibold text-fuchsia-400 flex items-center">
                        <span class="pr-1">
                            <img src="/7knights/assets/Transcendence_02.webp" alt="Transcendence_02.webp" class="w-6 h-6" draggable="false" />
                        </span>
                        Transcendence 2 Effects
                    </p>
                    {
                        skill.transcendence2.map((effect) => (
                            <p>- {effect}</p>
                        ))
                    }
                </div>
            )
        }
        <!-- Transcendence 6 -->
        {
            skill.transcendence6 && (
                <div class="rounded-md border border-fuchsia-700/50 bg-fuchsia-950/40 p-2 mt-2 leading-5">
                    <p class="font-semibold text-fuchsia-400 flex items-center">
                        <span class="pr-1">
                            <img src="/7knights/assets/Transcendence_06.webp" alt="Transcendence_06.webp" class="w-6 h-6" draggable="false" />
                        </span>
                        Transcendence 6 Effects
                    </p>
                    {
                        skill.transcendence6.map((effect) => (
                            <p>- {effect}</p>
                        ))
                    }
                </div>
            )
        }
    </div>
</div>