---
const { comp } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 mt-2 text-center font-bold rounded-xl border border-gray-500 select-none bg-zinc-800/50">
    <div class="p-2 overflow-hidden text-center content-center">
      <h5 class="text-sm md:text-base lg:text-xl break-words">
        { comp.name }
      </h5>
      <!-- <img src={`/7knights/assets/${comp.formation}`}
          alt={comp.formation} 
          class="mx-auto w-24 object-scale-down" 
          draggable="false" /> -->
    </div>
    {
      comp.hero1 ? (
        <div class="p-1 flex flex-col items-center overflow-hidden h-full">
          <p class="break-words text-sm md:text-base">{comp.hero1.role}</p>
          <a href={`/seven-knights/heroes/${comp.hero1.url}`} class="mt-auto relative">
            <img src={`/7knights/heroes/${comp.hero1.img}`}
              alt={comp.hero1.url} 
              class="w-28 aspect-square object-scale-down pb-2" 
              draggable="false"
            />
            <img src={`/7knights/assets/${comp.hero1.icnSet}`}
              alt={comp.hero1.icnSet} 
              class="w-6 aspect-square absolute bottom-2 left-1 z-50 m-1"
              draggable="false"
            />
          </a>
        </div>
      )
      :
      (
        <div class="p-1 flex flex-col items-center overflow-hidden h-full">
          <p class="break-words text-sm md:text-base">Fooder</p>
        </div>
      )
    }

    {
      comp.hero2 ? (
