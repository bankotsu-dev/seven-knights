---
import { getEntry } from "astro:content";
import type { Build } from "@/types/skr";
import RingItem from "@components/seven-knights/RingItem.astro";
import SetItem from "@components/seven-knights/SetItem.astro";

interface Props {
  build: Build;
  portrait: string;
  transcend: string;
}

const { build, portrait, transcend } = Astro.props;
const ring1 = await getEntry("skr_rings", build.rings.ringID1);
const ring2 = await getEntry("skr_rings", build.rings.ringID2);
const ring3 = await getEntry("skr_rings", build.rings.ringID3);
const ring4 = await getEntry("skr_rings", build.rings.ringID4);
---

<article
  class="mb-8 border-2 border-gray-500 rounded-2xl pr-3 pl-3 pb-3 max-w-3xl mx-auto select-none font-bold"
>
  <h2
    class="text-cyan-300 font-bold text-xl md:text-2xl text-center select-none
    bg-gradient-to-b from-gray-800 via-gray-950 to-gray-800 rounded-xl p-2"
  >
    {build.name}
  </h2>

  <div class="flex flex-col sm:flex-row gap-3">
    {/* Portrait */}
    <div class="w-full h-auto sm:w-1/4 flex flex-col">
      <img
        src={portrait}
        alt={portrait}
        class="w-40 sm:w-full mx-auto object-cover aspect-square"
        draggable="false"
      />
      <div class="flex items-center m-2 text-sm mt-auto">
        <img
          src="/7knights/assets/transcend.webp"
          alt="transcend"
          class="w-5 h-5 mr-1"
          draggable="false"
        />
        {transcend}
      </div>
    </div>

    {/* Gear */}
    <div class="w-full sm:w-3/4 flex flex-col gap-3">
      {/* Weapons + Armors */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {
          [build.weapon1, build.weapon2].map((weapon) => (
            <SetItem equip={weapon} />
          ))
        }

        {[build.armor1, build.armor2].map((armor) => <SetItem equip={armor} />)}
      </div>

      {/* Substats */}
      <div
        class="grid grid-cols-2 sm:grid-cols-3 gap-1 text-sm rounded text-black"
      >
        <p class="p-1 rounded text-center bg-green-400">{build?.substats[0]}</p>
        <p class="p-1 rounded text-center bg-green-300">{build?.substats[1]}</p>
        <p class="p-1 rounded text-center bg-green-200">{build?.substats[2]}</p>
        <p class="p-1 rounded text-center bg-yellow-200">
          {build?.substats[3]}
        </p>
        <p class="p-1 rounded text-center bg-yellow-300">
          {build?.substats[4]}
        </p>
        <p class="p-1 rounded text-center bg-yellow-400">
          {build?.substats[5]}
        </p>
      </div>

      {/* Rings */}
      <div
        class="bg-zinc-800/80 border border-zinc-700 p-2 rounded-lg shadow-sm"
      >
        <div class="grid grid-cols-4 gap-2 place-items-center">
          {
            [ring1, ring2, ring3, ring4]
              .filter((ring) => ring?.data)
              .map((ring) => <RingItem ring={ring!.data} />)
          }
        </div>
      </div>
    </div>
  </div>

  <p class="mt-3 text-sm">NOTE: {build.note}</p>
</article>
