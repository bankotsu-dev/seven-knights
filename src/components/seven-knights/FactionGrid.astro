---
import { getCollection } from "astro:content";
import HeroCard from "@components/seven-knights/HeroCard.astro";
import SkrTitle from "@components/seven-knights/SkrTitle.astro";
import type { Hero } from '@/types/skr';

const { tittle, faction, icon, unknown } = Astro.props;
const heroes: Hero[] = await getCollection(faction);
---

<article class="mb-8">
  <SkrTitle title={tittle} />
  <div class="flex flex-wrap justify-center gap-2 md:gap-3">
    {
      heroes.map((hero) => (
        <HeroCard
          hero={hero}
          icon={icon}
        />
      ))
    }
    {Array.from({ length: unknown }).map(() => (
    <div class="w-20 h-20 md:w-22 md:h-22 rounded-tl-2xl rounded-br-2xl">
      <img
        src="/7knights/heroes/Unknown.webp"
        alt="Unknow"
        class="w-auto h-full mx-auto object-contain"
        draggable="false"
      />
    </div>
  ))}

  </div>
</article>
