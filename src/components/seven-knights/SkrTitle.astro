---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="w-full flex items-center justify-center my-8 select-none">
  <!-- Línea izquierda -->
  <div class="flex-1 h-px bg-gradient-to-r from-transparent via-stone-500 to-stone-300 relative">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-stone-300 rotate-45"></div>
  </div>

  <!-- Título -->
  <div class="mx-2 px-4 md:px-6 py-1 md:py-2 rounded-full border-2 border-stone-300 bg-gradient-to-b from-gray-700 via-gray-950 to-gray-700">
    <h2 class="text-xl font-semibold text-white tracking-wide">
      {title}
    </h2>
  </div>

  <!-- Línea derecha -->
  <div class="flex-1 h-px bg-gradient-to-l from-transparent via-stone-500 to-stone-300 relative">
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-stone-300 rotate-45"></div>
  </div>
</div>