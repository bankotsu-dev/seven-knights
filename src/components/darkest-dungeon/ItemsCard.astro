---
const { item } = Astro.props;
---

<div class="rounded-lg border bg-card text-card-foreground shadow-sm text-center hover:bg-gray-700 border-slate-700">
    <div class="flex flex-col space-y-1.5 p-6">
        <div class="text-2xl font-semibold leading-none tracking-tight wrap-anywhere">
            { item.data.nombre }
        </div>
        <div class="text-sm text-muted-foreground">
            { item.data.efecto }
        </div>
    </div>
    <div class="p-6 pt-0">
        <img 
            src={ item.data.img }
            alt="Item Image" 
            class="m-auto"
        />
    </div>
    <div class="flex items-center p-6 pt-0">
        
    </div>
</div>