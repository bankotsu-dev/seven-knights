---
const { nombre, img, desc, url } = Astro.props;
---

<tr class="transition-colors hover:bg-gray-700">
    <td class="p-2 lg:p-4 align-middle">
        <a href={url}>
            <div class="flex max-h-screen items-center justify-center">
                <div class="block lg:flex w-full lg:flex-row rounded-xl">
                    <div class="relative m-0 lg:w-2/5 shrink-0 rounded-xl rounded-r-non">
                        <img
                            src={ img }
                            alt={ img }
                            class="h-full w-full object-cover"
                        />
                    </div>
                    <div class="p-6">
                        <h6 class="mb-4 block font-sans text-lg font-semibold leading-relaxed tracking-normal text-cyan-400 antialiased">
                            { nombre }
                        </h6>
                        <p class="mb-8 block font-sans text-base font-normal leading-relaxed antialiased">
                            { desc }
                        </p>
                    </div>
                </div>
            </div>
        </a>
    </td>
</tr>
